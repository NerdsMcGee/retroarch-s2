diff --git a/Makefile b/Makefile
index 43194c4..aad6b79 100644
--- a/Makefile
+++ b/Makefile
@@ -295,6 +295,20 @@ include $(DEVKITPRO)/libnx/switch_rules
     CFLAGS += -std=gnu11
     STATIC_LINKING = 1
 
+# Nintendo Game Cube / Wii / WiiU
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+include $(DEVKITPRO)/libounce/switch2_rules
+    EXT=a
+    TARGET := $(TARGET_NAME)_libretro_libnx.$(EXT)
+    DEFINES := -DSWITCH=1 -U__linux__ -U__linux -DRARCH_INTERNAL
+    CFLAGS  :=  $(DEFINES) -g -O3 -fPIE $(SWITCH2_CPU) -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec -Wl,--allow-multiple-definition -specs=$(LIBNX)/switch.specs
+    CFLAGS += $(INCDIRS)
+    CFLAGS  += $(INCLUDE)  -D__SWITCH__ -D__SWITCH2__ -DHAVE_LIBNX
+    CXXFLAGS := $(ASFLAGS) $(CFLAGS) -fexceptions -fno-rtti -std=gnu++11 
+    CFLAGS += -std=gnu11
+    STATIC_LINKING = 1
+
 # Nintendo Game Cube / Wii / WiiU
 else ifneq (,$(filter $(platform), ngc wii wiiu))
    TARGET := $(TARGET_NAME)_libretro_$(platform).a
diff --git a/libretro-common/features/features_cpu.c b/libretro-common/features/features_cpu.c
index 1a062c1..27125c5 100644
--- a/libretro-common/features/features_cpu.c
+++ b/libretro-common/features/features_cpu.c
@@ -250,7 +250,13 @@ retro_time_t cpu_features_get_time_usec(void)
 #elif defined(WIIU)
    return ticks_to_us(OSGetSystemTime());
 #elif defined(SWITCH) || defined(HAVE_LIBNX)
+#ifdef __SWITCH2__
+   /* The Switch 2's system tick is 31.25 MHz, not the Switch's 19.2 MHz:
+    * taken as 19.2 MHz, time ran 1.63 times too fast */
+   return armTicksToNs(armGetSystemTick()) / 1000;
+#else
    return (svcGetSystemTick() * 10) / 192;
+#endif
 #elif defined(_3DS)
    return osGetTime() * 1000;
 #elif defined(_POSIX_MONOTONIC_CLOCK) || defined(__QNX__) || defined(ANDROID) || defined(__MACH__)
