diff --git a/Makefile b/Makefile
index be005e4..85c3ce9 100644
--- a/Makefile
+++ b/Makefile
@@ -304,6 +304,20 @@ include $(DEVKITPRO)/libnx/switch_rules
     CFLAGS += -std=gnu11
     STATIC_LINKING = 1
 
+# Nintendo Game Cube / Wii / WiiU
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+include $(DEVKITPRO)/libounce/switch2_rules
+    EXT=a
+    TARGET := $(TARGET_NAME)_libretro_libnx.$(EXT)
+    DEFINES := -DSWITCH=1 -U__linux__ -U__linux -DRARCH_INTERNAL
+    CFLAGS  :=  $(DEFINES) -g -O2 -fPIE $(SWITCH2_CPU) -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec -Wl,--allow-multiple-definition -specs=$(LIBNX)/switch.specs
+    CFLAGS += $(INCDIRS)
+    CFLAGS  += $(INCLUDE)  -D__SWITCH__ -D__SWITCH2__
+    CXXFLAGS := $(ASFLAGS) $(CFLAGS) -fexceptions -fno-rtti -std=gnu++11 
+    CFLAGS += -std=gnu11
+    STATIC_LINKING = 1
+
 # Nintendo Game Cube / Wii / WiiU
 else ifneq (,$(filter $(platform), ngc wii wiiu))
    TARGET := $(TARGET_NAME)_libretro_$(platform).a
