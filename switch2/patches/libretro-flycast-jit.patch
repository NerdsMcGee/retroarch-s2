+#include <chrono>
+#include <unordered_map>
+extern int sw2_frame;
+static std::unordered_map<u32, unsigned long long> sw2_prof;
+static std::chrono::steady_clock::time_point sw2_prof_last;
+#include <vector>
+#include <algorithm>
+
+/* Block profile, with /retroarch-blkprof.on on the SD card: how often each
+ * block runs (a counter at the start of its code), what it holds (the
+ * counts below are made when it is compiled), and, every 150 frames, which
+ * blocks, shil operations and interpreter fallbacks the time goes to, in
+ * the trace. With the flag off nothing is added to the code. */
+extern "C" int sw2_flag_blkprof;
+extern "C" void sw2_trace(const char *m);
+struct Sw2BlkStat
+{
+	u32 vaddr, cycles, nops, nmem, nifb, bytes;
+	unsigned long long hits, prev;
+	std::vector<std::pair<u16, u16> > ifb;	// SH4 opcode, how many in the block
+	u8 ops[shop_max];
+};
+static std::unordered_map<u32, Sw2BlkStat *> sw2_blks;
+static Sw2BlkStat *sw2_blk_get(RuntimeBlockInfo *b)
+{
+	Sw2BlkStat *&s = sw2_blks[b->vaddr];
+	if (s == nullptr)
+	{
+		s = new Sw2BlkStat();
+		s->hits = s->prev = 0;
+	}
+	s->vaddr = b->vaddr;
+	s->cycles = b->guest_cycles;
+	s->nops = s->nmem = s->nifb = s->bytes = 0;
+	s->ifb.clear();
+	memset(s->ops, 0, sizeof(s->ops));
+	return s;
+}
+static void sw2_blk_note(Sw2BlkStat *s, const shil_opcode &op)
+{
+	if (s->ops[op.op] < 255)
+		s->ops[op.op]++;
+	s->nops++;
+	if (op.op == shop_readm || op.op == shop_writem)
+		s->nmem++;
+	if (op.op == shop_ifb)
+	{
+		const u16 opc = (u16)op.rs3._imm;
+		s->nifb++;
+		for (auto &p : s->ifb)
+			if (p.first == opc)
+			{
+				p.second++;
+				return;
+			}
+		s->ifb.push_back(std::make_pair(opc, (u16)1));
+	}
+}
+void sw2_blkprof_report(int frame)
+{
+	static int last = -1;
+	if (!sw2_flag_blkprof)
+		return;
+	if (last < 0)
+	{
+		last = frame;
+		for (auto &kv : sw2_blks)
+			kv.second->prev = kv.second->hits;
+		return;
+	}
+	if (frame - last < 150)
+		return;
+	const int nf = frame - last;
+	last = frame;
+
+	struct Row { unsigned long long cyc, d; Sw2BlkStat *s; };
+	std::vector<Row> rows;
+	rows.reserve(sw2_blks.size());
+	unsigned long long tb = 0, tc = 0, to = 0, tm = 0, ti = 0;
+	static unsigned long long opexec[shop_max];
+	memset(opexec, 0, sizeof(opexec));
+	std::map<u16, unsigned long long> ifbexec;
+	for (auto &kv : sw2_blks)
+	{
+		Sw2BlkStat *s = kv.second;
+		const unsigned long long d = s->hits - s->prev;
+		s->prev = s->hits;
+		if (d == 0)
+			continue;
+		tb += d;
+		tc += d * s->cycles;
+		to += d * s->nops;
+		tm += d * s->nmem;
+		ti += d * s->nifb;
+		Row r = { d * s->cycles, d, s };
+		rows.push_back(r);
+		for (int i = 0; i < (int)shop_max; i++)
+			if (s->ops[i])
+				opexec[i] += d * s->ops[i];
+		for (auto &p : s->ifb)
+			ifbexec[p.first] += d * p.second;
+	}
+	char b[256];
+	const double f = nf;
+	snprintf(b, sizeof(b), "fc: blk f%d win=%d compiled=%zu run=%zu per-frame: blocks=%.0f guestcycles=%.0f shilops=%.0f mem=%.0f ifb=%.0f",
+			frame, nf, sw2_blks.size(), rows.size(), tb / f, tc / f, to / f, tm / f, ti / f);
+	sw2_trace(b);
+
+	const size_t nt = std::min<size_t>(16, rows.size());
+	std::sort(rows.begin(), rows.end(), [](const Row &a, const Row &c) { return a.cyc > c.cyc; });
+	{
+		/* the host code that the guest cycles are spread over: all blocks run,
+		 * and the fewest (hottest first) that hold half, 90% and 99% of them */
+		unsigned long long all = 0, sops = 0, cum = 0, at50 = 0, at90 = 0, at99 = 0;
+		size_t n50 = 0, n90 = 0, n99 = 0;
+		for (auto &r : rows)
+		{
+			all += r.s->bytes;
+			sops += r.s->nops;
+		}
+		for (size_t i = 0; i < rows.size(); i++)
+		{
+			cum += rows[i].cyc;
+			at99 += rows[i].s->bytes; n99 = i + 1;
+			if (cum * 100 <= tc * 50) { at50 = at99; n50 = n99; }
+			if (cum * 100 <= tc * 90) { at90 = at99; n90 = n99; }
+			if (cum * 100 >= tc * 99) break;
+		}
+		snprintf(b, sizeof(b), "fc: blk code: run blocks=%zu %lluKB | 50%% of cycles in %zu blocks %lluKB | 90%% in %zu blocks %lluKB | 99%% in %zu blocks %lluKB | avg %.0f bytes/block, %.1f bytes/shilop",
+				rows.size(), all / 1024, n50, at50 / 1024, n90, at90 / 1024, n99, at99 / 1024,
+				rows.empty() ? 0.0 : (double)all / rows.size(), sops ? (double)all / sops : 0.0);
+		sw2_trace(b);
+	}
+	for (size_t i = 0; i < nt; i++)
+	{
+		const Sw2BlkStat *s = rows[i].s;
+		snprintf(b, sizeof(b), "fc: blk top%zu pc=%08x share=%.1f%% hits/frame=%.0f cycles=%u ops=%u mem=%u ifb=%u",
+				i + 1, s->vaddr, tc ? 100.0 * rows[i].cyc / tc : 0.0, rows[i].d / f, s->cycles, s->nops, s->nmem, s->nifb);
+		sw2_trace(b);
+	}
+
+	std::vector<std::pair<unsigned long long, int> > ov;
+	for (int i = 0; i < (int)shop_max; i++)
+		if (opexec[i])
+			ov.push_back(std::make_pair(opexec[i], i));
+	std::sort(ov.begin(), ov.end(), [](const std::pair<unsigned long long, int> &a, const std::pair<unsigned long long, int> &c) { return a.first > c.first; });
+	for (size_t i = 0; i < ov.size() && i < 16; i += 8)
+	{
+		int n = snprintf(b, sizeof(b), "fc: blk ops/frame:");
+		for (size_t j = i; j < ov.size() && j < i + 8 && j < 16; j++)
+			n += snprintf(b + n, sizeof(b) - n, " %s=%.0f", shil_opcode_name(ov[j].second), ov[j].first / f);
+		sw2_trace(b);
+	}
+
+	std::vector<std::pair<unsigned long long, u16> > iv;
+	for (auto &kv : ifbexec)
+		iv.push_back(std::make_pair(kv.second, kv.first));
+	std::sort(iv.begin(), iv.end(), [](const std::pair<unsigned long long, u16> &a, const std::pair<unsigned long long, u16> &c) { return a.first > c.first; });
+	for (size_t i = 0; i < iv.size() && i < 10; i += 5)
+	{
+		int n = snprintf(b, sizeof(b), "fc: blk ifb/frame:");
+		for (size_t j = i; j < iv.size() && j < i + 5 && j < 10; j++)
+		{
+			const char *name = OpDesc[iv[j].second] != nullptr && OpDesc[iv[j].second]->diss != nullptr ? OpDesc[iv[j].second]->diss : "?";
+			n += snprintf(b + n, sizeof(b) - n, " [%04x %s]=%.0f", iv[j].second, name, iv[j].first / f);
+		}
+		sw2_trace(b);
+	}
+}
+extern "C" int sw2_UpdateSystemProf(uintptr_t lr)
+{
+	auto now = std::chrono::steady_clock::now();
+	if (sw2_frame >= 1500 && sw2_frame < 1700)
+	{
+		RuntimeBlockInfoPtr blk = bm_GetBlock2((void *)lr);
+		u32 a = blk ? blk->addr : 0;
+		sw2_prof[a] += (unsigned long long)std::chrono::duration_cast<std::chrono::nanoseconds>(now - sw2_prof_last).count();
+	}
+	else if (sw2_frame == 1700 && !sw2_prof.empty())
+	{
+		std::vector<std::pair<unsigned long long, u32>> v;
+		unsigned long long tot = 0;
+		for (auto &kv : sw2_prof) { v.push_back({kv.second, kv.first}); tot += kv.second; }
+		std::sort(v.rbegin(), v.rend());
+		extern void sw2_trace(const char *);
+		char m[160];
+		snprintf(m, sizeof(m), "fc: prof total=%.1fms over 200 frames, blocks=%zu", tot / 1e6, v.size());
+		sw2_trace(m);
+		for (size_t i = 0; i < v.size() && i < 40; i++)
+		{
+			snprintf(m, sizeof(m), "fc: prof %08x %.1fms %.1f%%", v[i].second, v[i].first / 1e6, 100.0 * v[i].first / tot);
+			sw2_trace(m);
+		}
+		sw2_prof.clear();
+	}
+	int r = UpdateSystem();
+	sw2_prof_last = std::chrono::steady_clock::now();
+	return r;
+}
 
