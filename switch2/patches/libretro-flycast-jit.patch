+/* The framebuffer the game writes itself is shown by a render made at the
+ * vblank (rend_vblank()), when fb_dirty says it was written. That was said
+ * only by the 32-bit view's writes; a game writing its framebuffer through
+ * the 64-bit view or by store queue - a movie decoder's frames - was never
+ * seen to, and the screen stood still. A 64-bit offset is taken back to
+ * the 32-bit address the framebuffer's range is in. */
+static inline u32 pvr_unmap32(u32 o64)
+{
+	const u32 static_bits = VRAM_MASK - (VRAM_BANK_BIT * 2 - 1) + 3;
+	const u32 offset_bits = (VRAM_BANK_BIT - 1) & ~3;
+	return (o64 & static_bits) | ((o64 >> 1) & offset_bits) | (((o64 >> 2) & 1) ? VRAM_BANK_BIT : 0);
+}
+static inline void fb_written64(u32 o64, u32 bytes, int path)
+{
+	o64 &= VRAM_MASK;
+	for (u32 i = 0; i < bytes; i += 4)
+	{
+		const u32 a = pvr_unmap32(o64 + i);
+		if (a >= fb_watch_addr_start && a < fb_watch_addr_end)
+		{
+			fb_dirty = true;
+			return;
+		}
+	}
+}
