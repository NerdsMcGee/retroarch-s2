 #include "hw/holly/sb.h"
 #include "hw/holly/holly_intc.h"
+#include "rend/TexCache.h"
+#include "hw/mem/_vmem.h"
+#include "rend/rtt_watch.h"
+
+#ifdef __SWITCH2__
+/* Horizon does not hand a write fault to the core, so video memory that
+ * textures were made from is not made read-only here: the page is opened
+ * and marked as written in software before each write instead. */
+static inline void vram_soft_read(u32 offset)
+{
+	offset &= VRAM_MASK;
+	if (_vmem_vram_page_watched(offset / PAGE_SIZE))
+		rtt_watch_touch(offset & ~(u32)PAGE_MASK, PAGE_SIZE);
+}
+static inline void vram_soft_write(u32 offset)
+{
+	vram_soft_read(offset);
+	offset &= VRAM_MASK;
+	if (_vmem_vram_page_protected(offset / PAGE_SIZE))
+		VramLockedWriteOffset(offset);
+}
+#else
+#define vram_soft_write(x) do {} while (0)
+#define vram_soft_read(x) do {} while (0)
+#endif
 
 
 //YUV converter code :)
