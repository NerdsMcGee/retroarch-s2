diff --git a/Makefile.libretro b/Makefile.libretro
index 1842538..00fd87c 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -357,6 +357,22 @@ else ifeq ($(platform), libnx)
     CFLAGS += -std=gnu11
     STATIC_LINKING = 1
 
+# emscripten
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+    include $(DEVKITPRO)/libounce/switch2_rules
+    EXT=a
+    TARGET := $(TARGET_NAME)_libretro_libnx.$(EXT)
+    DEFINES := -DSWITCH=1 -U__linux__ -U__linux -DRARCH_INTERNAL
+    CFLAGS  :=  $(DEFINES) -g \
+                -O2 \
+            -fPIE $(SWITCH2_CPU) -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec -Wl,--allow-multiple-definition -specs=$(LIBNX)/switch.specs
+    CFLAGS += $(INCDIRS)
+    CFLAGS  += $(INCLUDE)  -D__SWITCH__ -D__SWITCH2__ -DHAVE_LIBNX
+    CXXFLAGS += $(ASFLAGS) $(CFLAGS) -fno-rtti -fno-exceptions -std=gnu++11
+    CFLAGS += -std=gnu11
+    STATIC_LINKING = 1
+
 # emscripten
 else ifeq ($(platform), emscripten)
    TARGET := $(TARGET_NAME)_libretro_$(platform).bc
