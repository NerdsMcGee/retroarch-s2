+// Offset from the staging view to the executable view, for Lightning's
+// aarch64 backend (pc-relative branches out of a block).
+extern "C" long jit_sw2_exec_delta;
+long jit_sw2_exec_delta;
+
+namespace RSP
+{
+namespace JIT
+{
+static constexpr size_t jit_size = 32 * 1024 * 1024;
+static Jit *current_jit;
+
+Allocator::~Allocator()
+{
+	Jit *j = static_cast<Jit *>(sw2_jit);
+	if (!j)
+		return;
+	if (current_jit == j)
+		current_jit = nullptr;
+	jitClose(j);
+	delete j;
+}
+
+void *Allocator::allocate_code(size_t size)
+{
+	Jit *j = static_cast<Jit *>(sw2_jit);
+	if (!j)
+	{
+		j = new Jit();
+		if (R_FAILED(jitCreate(j, jit_size)))
+		{
+			delete j;
+			return nullptr;
+		}
+		if (j->is_executable)
+			jitTransitionToWritable(j);
+		sw2_jit = j;
+		current_jit = j;
+		jit_sw2_exec_delta = long(uintptr_t(jitGetRxAddr(j)) - uintptr_t(jitGetRwAddr(j)));
+	}
+
+	// Cache-line granularity: nothing is page-protected here.
+	size = (size + 63) & ~size_t(63);
+	if (sw2_offset + size > jit_size)
+		return nullptr;
+	void *ret = static_cast<uint8_t *>(jitGetRwAddr(j)) + sw2_offset;
+	sw2_offset += size;
+	return ret;
+}
+
+bool Allocator::commit_code(void *code, size_t size)
+{
+	Jit *j = current_jit;
+	if (!j)
+		return false;
+	const uintptr_t off = uintptr_t(code) - uintptr_t(jitGetRwAddr(j));
+	const uintptr_t start = off & ~uintptr_t(63);
+	const uintptr_t end = (off + size + 63) & ~uintptr_t(63);
+	KaihenJitRange range = { u64(start), u64(end - start) };
+	return R_SUCCEEDED(kaihenJitPublishRanges(j, &range, 1));
+}
+
+void *Allocator::exec_address(void *code)
+{
+	return static_cast<uint8_t *>(code) + jit_sw2_exec_delta;
+}
+}
+}
