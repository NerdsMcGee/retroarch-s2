+++ b/GLideN64/src/Graphics/OpenGLContext/opengl_ColorBufferReaderWithPixelBuffer.cpp
@@ -55,7 +55,18 @@ const u8 * ColorBufferReaderWithPixelBuffer::_readPixels(const ReadColorBufferPa
 	// If Sync, read pixels from the buffer, copy them to RDRAM.
 	// If not Sync, read pixels from the buffer, copy pixels from the previous buffer to RDRAM.
 	if (!_params.sync) {
+#if defined(__SWITCH2__)
+		// A PBO that was never filled (fresh reader) holds nothing to copy: mapping it
+		// only waits on the GPU for garbage, so skip the RDRAM update this time.
+		m_filled[m_curIndex] = true;
+#endif
 		m_curIndex = (m_curIndex + 1) % m_numPBO;
+#if defined(__SWITCH2__)
+		if (!m_filled[m_curIndex]) {
+			m_bindBuffer->bind(Parameter(GL_PIXEL_PACK_BUFFER), ObjectHandle::null);
+			return nullptr;
+		}
+#endif
 		m_bindBuffer->bind(Parameter(GL_PIXEL_PACK_BUFFER), ObjectHandle(m_PBO[m_curIndex]));
 	}
 
