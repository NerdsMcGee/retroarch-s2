+#ifdef __SWITCH2__
+/* Switch 2 (libounce): code is written to the staging (rw) view and made
+ * runnable by publishing the written range to the rx view, which copies it
+ * and invalidates the publishing thread's instruction cache; another thread
+ * that runs it invalidates the range itself first (sw2_icache_sync). The
+ * libnx path's jitTransitionToExecutable() would publish the whole staging
+ * buffer on every write. */
+#include <kaihen.h>
+void SysPrintf(const char *fmt, ...);
+/* Publishes come from the compile thread and the emulator's thread: one at
+ * a time. */
+static Mutex sw2_pub_lock;
+static void sw2_jit_publish(void *start, void *end)
+{
+  uintptr_t rw = (uintptr_t)g_jit.rw_addr;
+  uintptr_t s = (uintptr_t)start, e = (uintptr_t)end;
+  /* The dynarec's ranges assume cache-maintenance granularity: callers
+   * pass inclusive-ish ends (do_clear_cache and mark_clear_cache use
+   * page + 4095), which cache maintenance covers by whole lines but a
+   * byte-exact publish does not - the page's last byte stayed stale, so a
+   * branch patched into a page's last slot ran with a stale top byte.
+   * Publish whole 64-byte lines, as the cache maintenance would. */
+  s &= ~(uintptr_t)63;
+  e = (e + 63) & ~(uintptr_t)63;
+  if (s < rw) s = rw;
+  if (e > rw + g_jit.size) e = rw + g_jit.size;
+  if (e <= s)
+    return;
+  KaihenJitRange r = { (u64)(s - rw), (u64)(e - s) };
+  mutexLock(&sw2_pub_lock);
+  Result rc = kaihenJitPublishRanges(&g_jit, &r, 1);
+  mutexUnlock(&sw2_pub_lock);
+  if (R_FAILED(rc)) {
+    SysPrintf("kaihenJitPublishRanges failed: %08x\n", (unsigned)rc);
+    abort();
+  }
+}
+#endif
 
