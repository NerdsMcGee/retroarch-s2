diff --git a/libpcsxcore/new_dynarec/new_dynarec.c b/libpcsxcore/new_dynarec/new_dynarec.c
index fb99df6..65c695c 100644
--- a/libpcsxcore/new_dynarec/new_dynarec.c
+++ b/libpcsxcore/new_dynarec/new_dynarec.c
@@ -35,6 +35,43 @@
 #include <switch.h>
 static Jit g_jit;
 #endif
+#ifdef __SWITCH2__
+/* Switch 2 (libounce): code is written to the staging (rw) view and made
+ * runnable by publishing the written range to the rx view, which copies it
+ * and invalidates the instruction cache (broadcast to all cores). The libnx
+ * path's jitTransitionToExecutable() would publish the whole staging buffer
+ * on every write. */
+#include <ouncehen.h>
+void SysPrintf(const char *fmt, ...);
+/* Publishes come from the compile thread and the emulator's thread: one at
+ * a time. */
+static Mutex sw2_pub_lock;
+static void sw2_jit_publish(void *start, void *end)
+{
+  uintptr_t rw = (uintptr_t)g_jit.rw_addr;
+  uintptr_t s = (uintptr_t)start, e = (uintptr_t)end;
+  /* The dynarec's ranges assume cache-maintenance granularity: callers
+   * pass inclusive-ish ends (do_clear_cache and mark_clear_cache use
+   * page + 4095), which cache maintenance covers by whole lines but a
+   * byte-exact publish does not - the page's last byte stayed stale, so a
+   * branch patched into a page's last slot ran with a stale top byte.
+   * Publish whole 64-byte lines, as the cache maintenance would. */
+  s &= ~(uintptr_t)63;
+  e = (e + 63) & ~(uintptr_t)63;
+  if (s < rw) s = rw;
+  if (e > rw + g_jit.size) e = rw + g_jit.size;
+  if (e <= s)
+    return;
+  OuncehenJitRange r = { (u64)(s - rw), (u64)(e - s) };
+  mutexLock(&sw2_pub_lock);
+  Result rc = ouncehenJitPublishRanges(&g_jit, &r, 1);
+  mutexUnlock(&sw2_pub_lock);
+  if (R_FAILED(rc)) {
+    SysPrintf("ouncehenJitPublishRanges failed: %08x\n", (unsigned)rc);
+    abort();
+  }
+}
+#endif
 
 #include "new_dynarec_config.h"
 #include "../psxhle.h"
@@ -675,6 +712,8 @@ static void mprotect_w_x(void *start, void *end, int is_x)
     sceKernelCloseVMDomain();
   else
     sceKernelOpenVMDomain();
+  #elif defined(__SWITCH2__)
+  (void)start; (void)end; (void)is_x;
   #elif defined(HAVE_LIBNX)
   Result rc;
   // check to avoid the full flush in jitTransitionToExecutable()
@@ -714,6 +753,8 @@ void new_dyna_clear_cache(void *start, void *end)
     ctr_clear_cache_range(start, end);
   else
     ctr_clear_cache();
+  #elif defined(__SWITCH2__)
+  sw2_jit_publish(start, end);
   #elif defined(HAVE_LIBNX)
   if (g_jit.type == JitType_CodeMemory) {
     armDCacheClean(start, len);
@@ -745,8 +786,13 @@ static void end_tcache_write(void *start, void *end, int clear_cache)
   if ((size_t)ndrc_g.thread.dirty_end < (size_t)end)
     ndrc_g.thread.dirty_end = end;
 #endif
+#ifdef __SWITCH2__
+  (void)clear_cache;
+  new_dyna_clear_cache(start, end);
+#else
   if (clear_cache)
     new_dyna_clear_cache(start, end);
+#endif
 
   mprotect_w_x(start, end, 1);
 }
@@ -1649,7 +1695,7 @@ static void *get_trampoline(const void *f)
     start_tcache_write(&tramp->f[i], &tramp->f[i + 1]);
     tramp->f[i] = f;
     end_tcache_write(&tramp->f[i], &tramp->f[i + 1], 1);
-#ifdef HAVE_LIBNX
+#if defined(HAVE_LIBNX) && !defined(__SWITCH2__)
     // invalidate the RX mirror (unsure if necessary, but just in case...)
     armDCacheFlush(&ndrc->tramp.f[i], sizeof(ndrc->tramp.f[i]));
 #endif
@@ -3616,8 +3662,15 @@ static void do_store_smc_check(struct compile_state *st, int i,
   //if (i_regs->waswritten & (1<<dops[i].rs1))
   //  return;
   // (naively) assume nobody will run code from stack
+  // Not on Switch 2: Gran Turismo copies its overlay loader onto the stack
+  // and runs it there (FlushCache, copy the new EXE, Exec). With stack
+  // stores unchecked, compiled stack code went stale and the race load
+  // jumped to the old program (8fa40028 / RI loop at 80029ff8). Checking
+  // them fixed it (2026-11-12); the cost is one byte load and a branch.
+#ifndef __SWITCH2__
   if (dops[i].rs1 == 29)
     return;
+#endif
 
   int j, imm_maxdiff = 32, imm_min = cinfo[i].imm, imm_max = cinfo[i].imm, count = 1;
   if (i < st->slen - 1 && dops[i+1].is_store && dops[i+1].rs1 == dops[i].rs1
@@ -6707,10 +6760,20 @@ void new_dynarec_init(void)
   if (R_FAILED(rc))
     SysPrintf("jitCreate failed: %08x\n", rc);
   SysPrintf("jitCreate: RX: %p RW: %p type: %d\n", g_jit.rx_addr, g_jit.rw_addr, g_jit.type);
+#ifdef __SWITCH2__
+  if (R_FAILED(rc))
+    abort();
+  if (g_jit.is_executable)
+    jitTransitionToWritable(&g_jit);
+#else
   jitTransitionToWritable(&g_jit);
+#endif
   ndrc = g_jit.rx_addr;
   ndrc_write_ofs = (char *)g_jit.rw_addr - (char *)ndrc;
   memset(NDRC_WRITE_OFFSET(&ndrc->tramp), 0, sizeof(ndrc->tramp));
+#ifdef __SWITCH2__
+  new_dyna_clear_cache(NDRC_WRITE_OFFSET(&ndrc->tramp), NDRC_WRITE_OFFSET(&ndrc->tramp + 1));
+#endif
   #else
   uintptr_t desired_addr = 0;
   int prot = PROT_READ | PROT_WRITE | PROT_EXEC;
