diff --git a/libretro/Makefile b/libretro/Makefile
index 1169b98..cdfac1d 100644
--- a/libretro/Makefile
+++ b/libretro/Makefile
@@ -136,6 +136,16 @@ else ifeq ($(platform), libnx)
    CXXFLAGS := $(ASFLAGS) $(CFLAGS)
