 # Nintendo WiiU
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+   include $(DEVKITPRO)/libounce/switch2_rules
+   TARGET := $(TARGET_NAME)_libretro_libnx.a
+   DEFINES += -DSWITCH=1 -D__SWITCH__ -D__SWITCH2__ -DARM
+   CFLAGS += $(DEFINES) -fPIE -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec
+   CFLAGS += -march=armv8-a -mtune=cortex-a57 -mtp=soft -mcpu=cortex-a57+crc+fp+simd -ffast-math
+   CXXFLAGS := $(ASFLAGS) $(CFLAGS)
+   STATIC_LINKING = 1
+# Nintendo WiiU
 else ifeq ($(platform), wiiu)
    TARGET := $(TARGET_NAME)_libretro_$(platform).a
    CC = $(DEVKITPPC)/bin/powerpc-eabi-gcc$(EXE_EXT)
