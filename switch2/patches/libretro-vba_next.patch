diff --git a/Makefile.libretro b/Makefile.libretro
index b29fba0..b5d423c 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -444,6 +444,21 @@ else ifeq ($(platform), libnx)
     CFLAGS += -std=gnu11
     STATIC_LINKING = 1
 
+# Nintendo Switch (libtransistor)
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+    include $(DEVKITPRO)/libounce/switch2_rules
+    EXT=a
+    TARGET := $(TARGET_NAME)_libretro_libnx.$(EXT)
+    DEFINES := -DSWITCH=1 -U__linux__ -U__linux -DRARCH_INTERNAL -DHAVE_THREADS=1
+    CFLAGS := $(DEFINES) -g -O3 \
+		      -fPIE -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec -Wl,--allow-multiple-definition -specs=$(LIBNX)/switch.specs
+    CFLAGS += $(INCDIRS)
+    CFLAGS += $(INCLUDE)  -D__SWITCH__ -D__SWITCH2__ -DHAVE_LIBNX
+    CXXFLAGS := $(ASFLAGS) $(CFLAGS) -fno-rtti -fno-exceptions -std=gnu++11
+    CFLAGS += -std=gnu11
+    STATIC_LINKING = 1
+
 # Nintendo Switch (libtransistor)
 else ifeq ($(platform), switch)
 	EXT=a
