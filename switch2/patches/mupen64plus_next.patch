--- a/libretro-common/glsm/glsm.c
+++ b/libretro-common/glsm/glsm.c
@@ -3340,6 +3340,33 @@ void* glsm_get_proc_address(const char* sym)
 }
 
 extern void initGLFunctions();
+#ifdef __SWITCH2__
+#include <switch.h>
+extern void sw2_gl_ctx_ensure(void) __attribute__((weak));
+/* Switch 2: the GL context is handed between the core's thread and the
+ * video thread, and the frontend takes it back for the core only when
+ * the core needs it, after the video thread's present of the last frame.
+ * The bind at the start of retro_run() is put off until the renderer is
+ * entered (sw2_glsm_bind_now(), called by GLideN64's plugin API), so a
+ * frame in which the game draws nothing does not wait for that present. */
+static int sw2_glsm_bind_pending;
+void sw2_glsm_bind_now(void)
+{
+   if (!sw2_glsm_bind_pending)
+      return;
+   sw2_glsm_bind_pending = 0;
+   {
+      extern unsigned long long sw2_n64_bind_ticks, sw2_n64_bind_max;
+      const u64 t0 = armGetSystemTick();
+      if (sw2_gl_ctx_ensure)
+         sw2_gl_ctx_ensure();
+      glsm_state_bind();
+      const u64 dt = armGetSystemTick() - t0;
+      sw2_n64_bind_ticks += dt;
+      if (dt > sw2_n64_bind_max) sw2_n64_bind_max = dt;
+   }
+}
+#endif
 bool glsm_ctl(enum glsm_state_ctl state, void *data)
 {
    switch (state)
@@ -3385,10 +3412,21 @@ bool glsm_ctl(enum glsm_state_ctl state, void *data)
          glsm_state_setup();
          break;
       case GLSM_CTL_STATE_UNBIND:
+#ifdef __SWITCH2__
+         if (sw2_glsm_bind_pending)
+         {
+            sw2_glsm_bind_pending = 0;
+            break;
+         }
+#endif
          glsm_state_unbind();
          break;
       case GLSM_CTL_STATE_BIND:
+#ifdef __SWITCH2__
+         sw2_glsm_bind_pending = 1;
+#else
          glsm_state_bind();
+#endif
          break;
       case GLSM_CTL_NONE:
       default:
