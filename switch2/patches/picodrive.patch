 extern u8 *tcache;
 
+#ifdef __SWITCH2__
+/* Switch 2: code runs from the Jit's executable view and is written through
+ * its staging view, drc_wofs bytes away; a written range is made runnable
+ * by drc_publish() (platform/libretro/libretro.c). */
+#include <stddef.h>
+extern ptrdiff_t drc_wofs;
+void drc_publish(void *start, void *end);
+#define DRC_W(p) ((void *)((u8 *)(p) + drc_wofs))
+#else
+#define DRC_W(p) ((void *)(p))
+#endif
+
