+#ifdef __SWITCH2__
+#include <kaihen.h>
+static Jit drc_jit;
+static int drc_jit_state;  /* 0 not made, 1 made, -1 failed */
+ptrdiff_t drc_wofs;
+void drc_publish(void *start, void *end)
+{
+   uintptr_t rx = (uintptr_t)drc_jit.rx_addr;
+   uintptr_t s = (uintptr_t)start & ~(uintptr_t)63;
+   uintptr_t e = ((uintptr_t)end + 63) & ~(uintptr_t)63;
+   KaihenJitRange r;
+   Result rc;
+   if (drc_jit_state != 1)
+      return;
+   if (s < rx)
+      s = rx;
+   if (e > rx + drc_jit.size)
+      e = rx + drc_jit.size;
+   if (e <= s)
+      return;
+   r.offset = s - rx;
+   r.size   = e - s;
+   rc = kaihenJitPublishRanges(&drc_jit, &r, 1);
+   if (R_FAILED(rc))
+   {
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR, "kaihenJitPublishRanges failed: %08x\n", (unsigned)rc);
+      abort();
+   }
+}
+#endif
