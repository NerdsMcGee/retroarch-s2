+# (armv7 a7, hard point, neon based) ### 
+# NESC, SNESC, C64 mini 
+# libounce (Switch 2)
+else ifeq ($(platform), libounce)
+   include $(DEVKITPRO)/libounce/switch2_rules
+   PORTLIBS := $(PORTLIBS_PATH)/switch
+   TARGET := $(TARGET_NAME)_libretro_libnx.a
+   DEFINES := -DSWITCH=1 -D__SWITCH__ -D__SWITCH2__ -DARM
+   CFLAGS := $(DEFINES) -fPIE -I$(PORTLIBS)/include/ -I$(LIBNX)/include/ -ffunction-sections -fdata-sections -ftls-model=local-exec -specs=$(LIBNX)/switch.specs
+   CFLAGS += -mtp=soft $(SWITCH2_CPU) -ffast-math
+   CXXFLAGS := $(ASFLAGS) $(CFLAGS)
+   STATIC_LINKING=1
+   STATIC_LINKING_LINK=1
+
+# Classic Platforms ####################
+# Platform affix = classic_<ISA>_<µARCH>
